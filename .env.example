# REQUIRED on public cloud hosts (set in Render/Railway UI, never commit real secrets)
NODE_ENV=production
ADMIN_PASSWORD=replace-with-a-long-random-merchant-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Optional: polished AI replies, NOT autonomous transactions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set to a persistent volume mount in hosting provider
DATA_FILE=/var/data/decisiongap-state.json
# Render and Railway provide PORT automatically. Do not hardcode on these hosts.
# PORT=3000
HOST=0.0.0.0

# Connected store (optional; requires a real Shopify shop and Storefront API token)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
# For cloud hosts with persistent disk; recommended over the local JSON store
SQLITE_FILE=/var/data/decisiongap.sqlite
